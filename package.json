{
  "name": "sigma",
  "version": "0.0.1",
  "description": "Mis propios plugins para el agente pi, separados para instalar solo lo que quiera.",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "pi-extension"
  ],
  "files": [
    "agent/extensions",
    "README.md"
  ],
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test 'agent/extensions/**/*.test.ts'"
  },
  "pi": {
    "extensions": [
      "./agent/extensions/*/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@types/node": "^25.6.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
